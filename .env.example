# Copiar como .env y completar con valores reales. .env nunca se sube al repo.
# En local (sin perfil) todas tienen un valor por defecto. En producción (perfil "prod", que activa
# el Dockerfile) las marcadas como OBLIGATORIA no tienen default: si falta alguna, la app no arranca.
# En Dokploy estas variables se cargan en la pestaña "Environment" de la aplicación (ver DEPLOY.md).

# --- Datasource ---
# OBLIGATORIAS en prod: DB_HOST (host interno del MySQL en Dokploy), DB_NAME, DB_USER, DB_PASSWORD
DB_HOST=localhost
DB_PORT=3306
DB_NAME=epr_db
DB_USER=root
DB_PASSWORD=

# --- JWT ---
# OBLIGATORIA en prod, mínimo 32 caracteres. Generar con: openssl rand -base64 64
JWT_SECRET=cambiar-este-secreto-en-produccion-por-uno-largo-y-aleatorio
# Duración de la sesión en ms. Default en prod: 7 días.
JWT_EXPIRATION_MS=604800000

# --- Admin inicial (solo se crea si la tabla de usuarios está vacía) ---
# En prod solo se exigen si la base está vacía (primer arranque); después se pueden quitar.
ADMIN_EMAIL=admin@epr.com
ADMIN_PASSWORD=

# --- Frontend ---
# OBLIGATORIA en prod: URL pública del front (links de los mails y CORS), ej: https://epr.com.ar
FRONTEND_URL=http://localhost:3000
# Opcional: más de un dominio permitido por CORS, separados por coma. Default: FRONTEND_URL
# CORS_ALLOWED_ORIGINS=https://epr.com.ar,https://www.epr.com.ar

# --- Email (SMTP) ---
# Con Gmail usar una "contraseña de aplicación", no la contraseña de la cuenta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@epr.com
